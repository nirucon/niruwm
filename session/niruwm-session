#!/bin/sh
# NIRUWM X11 session — the single entry point for SDDM, startx and `uvm`.
#
# Design rules:
#  * Use only the suite's own tools; no external desktop helper profile.
#  * Write runtime data, cache and logs only in the user's XDG directories.
#  * Everything started here is tracked and killed on exit, so logging out
#    leaves no bar, compositor or notification daemon behind.
set -eu

SELF_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
PATH="$SELF_DIR:$HOME/.local/bin:$PATH"
export PATH

case "${1:-}" in
  --version) printf '%s\n' 'NIRUWM session 0.27.1'; exit 0 ;;
  --help) printf '%s\n' 'Usage: niruwm-session (from startx or a display manager)'; exit 0 ;;
esac

# Log the entire startup, not only the WM: failures before the WM (notably
# runtime-directory setup on a TTY) otherwise leave no diagnostic behind.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/niruwm"
WM_LOG="$LOG_DIR/session.log"
# The log has a size cap: at most LOG_MAX bytes, plus three older copies
# (session.log.1 newest to session.log.3), each also capped. Every program in
# the session writes here, and one laptop's log had reached 81 MB. NIRUWM
# applies the same cap during the session (see src/logcap.rs).
LOG_MAX=8388608
LOG_KEEP=3
rotate_log() {
  [ -f "$1" ] || return 0
  size=$(wc -c < "$1" 2>/dev/null) || return 0
  [ "${size:-0}" -gt "$LOG_MAX" ] || return 0
  i=$LOG_KEEP
  while [ "$i" -gt 1 ]; do
    j=$((i - 1))
    [ -f "$1.$j" ] && mv -f "$1.$j" "$1.$i"
    i=$j
  done
  tail -c "$LOG_MAX" "$1" > "$1.1" 2>/dev/null || :
  : > "$1"
}
if [ "${NIRU_SESSION_LOG_READY:-0}" != 1 ]; then
  exec 3>&2
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  rotate_log "$WM_LOG" 2>/dev/null || :
fi
mkdir -p "$LOG_DIR" 2>/dev/null || true
if { : >>"$WM_LOG"; } 2>/dev/null; then
  exec 2>>"$WM_LOG"
  NIRU_SESSION_LOG_READY=1
  export NIRU_SESSION_LOG_READY
else
  WM_LOG=/dev/null
fi
log() {
  printf '[niruwm] %s\n' "$*" >&2
  [ "$WM_LOG" = /dev/null ] || printf '[niruwm] %s\n' "$*" >&3
}
cleanup() { :; }
session_exit() {
  status=$?
  trap - EXIT
  if [ "$status" -ne 0 ]; then
    log "session exited with status $status; see $WM_LOG"
  fi
  cleanup
  exit "$status"
}
trap session_exit EXIT
printf '\n=== %s session startup ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" >&2

[ -n "${DISPLAY:-}" ] || { log "DISPLAY is unset; launch from SDDM or startx"; exit 1; }

WM="$SELF_DIR/niruwm"
for candidate in "$SELF_DIR/niruwm" "$HOME/.local/bin/niruwm"; do
  [ -x "$candidate" ] && { WM="$candidate"; break; }
done
[ -x "$WM" ] || { log "niruwm binary not found"; exit 127; }

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
NM_CONF="$CONFIG_HOME/niruwm/session.conf"

# ── User preferences (optional, never required) ──────────────────────────────
# shellcheck source=/dev/null
[ -r "$NM_CONF" ] && . "$NM_CONF"
KEYBOARD_LAYOUT="${KEYBOARD_LAYOUT:-}"
KEYBOARD_VARIANT="${KEYBOARD_VARIANT:-}"
START_DUNST="${START_DUNST:-1}"
# auto, native, dunst or external. Auto prefers the verified native service
# when it is installed, and keeps Dunst as the standalone/fallback provider.
NOTIFICATION_PROVIDER="${NOTIFICATION_PROVIDER:-auto}"
# always, once or off. Read from session.conf like the options above.
WELCOME_NOTIFICATION="${WELCOME_NOTIFICATION:-always}"
START_PICOM="${START_PICOM:-1}"
START_IDLE="${START_IDLE:-1}"
START_SLEEP_LOCK="${START_SLEEP_LOCK:-1}"

# ── Restart in place ────────────────────────────────────────────────────────
# `niructl restart-wm` makes NIRUWM save its windows and exit with status 75.
# This script then runs the installed session script again with
# NIRUWM_SESSION_CONTINUE=1: the X server, D-Bus, audio and every open window
# stay; only the window manager and the helpers whose program changed are
# replaced. NIRUWM offers the command only when this variable says the
# session script understands status 75.
WM_RESTART_STATUS=75
NIRUWM_SESSION_RESTART=1
export NIRUWM_SESSION_RESTART
CONTINUE="${NIRUWM_SESSION_CONTINUE:-0}"
unset NIRUWM_SESSION_CONTINUE
case "$0" in
  /*) SESSION_SCRIPT=$0 ;;
  *) SESSION_SCRIPT="$SELF_DIR/$(basename -- "$0")" ;;
esac

# A restart in place already has all of this: the environment is inherited.
if [ "$CONTINUE" != 1 ]; then
# A plain startx login may have no elogind/PAM runtime directory. A user cannot
# mkdir /run/user/<uid>; never make audio setup a prerequisite for starting X.
# Establish one private, user-owned directory before D-Bus and all helpers.
runtime_ok() {
  [ -n "$1" ] && [ -d "$1" ] && [ ! -L "$1" ] && [ -w "$1" ] &&
    [ "$(stat -c '%u:%a' "$1" 2>/dev/null)" = "$(id -u):700" ]
}
if ! runtime_ok "${XDG_RUNTIME_DIR:-}"; then
  if runtime_ok "/run/user/$(id -u)"; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    XDG_RUNTIME_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/niruwm/runtime"
    (umask 077; mkdir -p "$XDG_RUNTIME_DIR") || {
      log "cannot create runtime directory: $XDG_RUNTIME_DIR"; exit 1;
    }
    runtime_ok "$XDG_RUNTIME_DIR" || {
      log "runtime directory must be owned by this user with mode 700: $XDG_RUNTIME_DIR"; exit 1;
    }
    log "using private runtime directory: $XDG_RUNTIME_DIR (no login runtime available)"
  fi
fi
export XDG_RUNTIME_DIR

# ── Session bus ──────────────────────────────────────────────────────────────
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- "$0" "$@"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax)"
fi
command -v dbus-update-activation-environment >/dev/null 2>&1 &&
  dbus-update-activation-environment DISPLAY XAUTHORITY 2>/dev/null || :

# ── Audio: only Void needs this; Arch and Debian use systemd user units ──────
DISTRO=""
[ -r /etc/os-release ] && DISTRO="$(. /etc/os-release 2>/dev/null; printf '%s' "${ID:-}")"
audio_core_ready() {
  command -v wpctl >/dev/null 2>&1 || return 1
  if command -v timeout >/dev/null 2>&1; then
    timeout 2 wpctl status >/dev/null 2>&1
  else
    wpctl status >/dev/null 2>&1
  fi
}
# Stop only this session's audio helpers. A user-wide pkill can tear down the
# audio of another graphical session using the same account.
stop_owned_audio() {
  for name in pipewire-pulse wireplumber pipewire; do
    for pid in $(pgrep -u "$(id -u)" -x "$name" 2>/dev/null); do
      [ -n "$pid" ] || continue
      old_runtime=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^XDG_RUNTIME_DIR=//p')
      [ "$old_runtime" = "$XDG_RUNTIME_DIR" ] || continue
      kill "$pid" 2>/dev/null || :
    done
  done
}
if [ "$DISTRO" = void ] && command -v pipewire >/dev/null 2>&1; then
  # A socket is not readiness: a stale pipewire-0 can survive after the core
  # server died, while pipewire-pulse runs on and wpctl cannot connect.
  if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    (umask 077; mkdir -p "$XDG_RUNTIME_DIR") 2>/dev/null || :
    log "recreated $XDG_RUNTIME_DIR for PipeWire"
  fi
  if ! audio_core_ready; then
    log "PipeWire core is not usable; replacing only this session's stale audio helpers"
    stop_owned_audio
    rm -f "$XDG_RUNTIME_DIR/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0.lock" 2>/dev/null || :
    pipewire >/dev/null 2>&1 & PIPEWIRE_PID=$!
    i=0
    while [ "$i" -lt 40 ] && ! audio_core_ready; do sleep 0.05; i=$((i + 1)); done
    if ! audio_core_ready; then
      log "PipeWire did not become usable; audio and the volume module will be unavailable"
    fi
  fi
  if audio_core_ready; then
    for d in wireplumber pipewire-pulse; do
      command -v "$d" >/dev/null 2>&1 || continue
      pgrep -u "$(id -u)" -x "$d" >/dev/null 2>&1 && continue
      "$d" >/dev/null 2>&1 &
      case "$d" in
        wireplumber) WIREPLUMBER_PID=$! ;;
        pipewire-pulse) PULSE_PID=$! ;;
      esac
    done
    # Wait for the session's default nodes, not merely for a process or socket.
    i=0
    while [ "$i" -lt 30 ] && ! wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; do
      sleep 0.05
      i=$((i + 1))
    done
    if ! wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; then
      log "audio server is reachable but no default output is ready yet"
    fi
  fi
fi

# The lock screen cannot show a message while it covers the screen, so its
# diagnostic log is always on. It is tiny and only written on lock and unlock.
NIRULOCK_TRACE=1
export NIRULOCK_TRACE

# ── Environment: the NIRU Noir look used by every NIRUWM-adjacent app ───────
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
[ -f "$HOME/.gtkrc-2.0" ] && export GTK2_RC_FILES="$HOME/.gtkrc-2.0"
command -v qt5ct >/dev/null 2>&1 && export QT_QPA_PLATFORMTHEME=qt5ct
command -v qt6ct >/dev/null 2>&1 && export QT_QPA_PLATFORMTHEME=qt6ct
command -v kvantummanager >/dev/null 2>&1 && export QT_STYLE_OVERRIDE=kvantum
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export COLORTERM=truecolor
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-NIRUWM}"

# ── Keyboard: Swedish by default, overridable ───────────────────────────────
if [ -n "$KEYBOARD_LAYOUT" ] && command -v setxkbmap >/dev/null 2>&1; then
  if [ -n "$KEYBOARD_VARIANT" ]; then
    setxkbmap "$KEYBOARD_LAYOUT" -variant "$KEYBOARD_VARIANT" 2>/dev/null || log "setxkbmap failed"
  else
    setxkbmap "$KEYBOARD_LAYOUT" 2>/dev/null || log "setxkbmap failed"
  fi
fi
# Input settings are one canonical config for the session and the launcher.
# Apply them after the system layout, so an explicit user choice wins.
if command -v niructl >/dev/null 2>&1; then
  niructl input apply --quiet >/dev/null 2>&1 || log 'input settings could not be applied'
fi

if [ -r "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1; then
  xrdb -merge "$HOME/.Xresources" || log 'could not load optional .Xresources'
fi

# ── Root background: Niru Noir unless a wallpaper tool takes over ───────────
BG="0f0f10"
[ -r "$CONFIG_HOME/niruwm/themes/niru-noir.toml" ] &&
  BG="$(sed -n 's/^background *= *"\([0-9a-fA-F]\{6\}\)".*/\1/p' "$CONFIG_HOME/niruwm/themes/niru-noir.toml" | head -n1)"
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid "#${BG:-0f0f10}" 2>/dev/null || :
  # The X server root cursor defaults to a cross. Set the normal arrow so a
  # fresh session does not look like a broken or debugging desktop.
  xsetroot -cursor_name left_ptr 2>/dev/null || :
fi

# Regenerate kitty/fish colours for the configured theme at login. Optional:
# NIRUWM works without NIRUX but only the NIRUX hook writes terminal colours.
if [ -x "$HOME/.local/bin/nirux-theme-hook" ]; then
  "$HOME/.local/bin/nirux-theme-hook" >/dev/null 2>&1 || log 'terminal theme hook failed'
fi
fi # end of first-start-only setup

# ── Helper processes, all tracked for clean logout ──────────────────────────
STATUS_PID=""; DUNST_PID=""; NOTIFY_PID=""; CLIPBOARD_PID=""; GESTURES_PID=""; STARTUP_SOUND_PID=""; PICOM_PID=""; IDLE_PID=""; LOCK_PID=""; BAT_PID=""; AUTO_PID=""; SLEEP_LOCK_PID=""; NIGHTLIGHT_PID=""; POLKIT_PID=""; AUTOSTART_PID=""; DISPLAY_WATCH_PID=""; NIRUSHARE_PID=""; NIRUDICTATE_PID=""; POWER_PID=""; PIPEWIRE_PID=""; WIREPLUMBER_PID=""; PULSE_PID=""
cleanup() {
  # A deliberate session exit gets the shutdown cue. Playback is async and
  # never delays the actual logout; a crash path still reaches this only if
  # the WM exits normally.
  command -v nirux >/dev/null 2>&1 && nirux sounds play shutdown >/dev/null 2>&1 || :
  # Work modes are session-scoped. Clear them before helpers disappear, so a
  # timer from this session cannot change the next login.
  command -v niructl >/dev/null 2>&1 && niructl mode stop --quiet >/dev/null 2>&1 || :
  # Studio mode keeps its state on the X root, so it ends with the session
  # anyway; this puts DND and the power profile back while NIRUNOTIFY is
  # still running. The compositor is stopped just below in any case.
  command -v niructl >/dev/null 2>&1 && niructl studio off --session-end --quiet >/dev/null 2>&1 || :
  command -v niructl >/dev/null 2>&1 && niructl compositor off --quiet >/dev/null 2>&1 || :
  # The sleep-lock helper has its own child inhibitor and monitor. Give it a
  # TERM first so its trap can release them, then make sure the direct child
  # is gone even if the trap was not reached.
  if [ -n "$SLEEP_LOCK_PID" ]; then
    pkill -TERM -P "$SLEEP_LOCK_PID" 2>/dev/null || :
  fi
  for pid in $STATUS_PID $DUNST_PID $NOTIFY_PID $CLIPBOARD_PID $GESTURES_PID $STARTUP_SOUND_PID $PICOM_PID $IDLE_PID $LOCK_PID $BAT_PID $AUTO_PID $SLEEP_LOCK_PID $NIGHTLIGHT_PID $POLKIT_PID $AUTOSTART_PID $DISPLAY_WATCH_PID $NIRUSHARE_PID $NIRUDICTATE_PID $POWER_PID $PIPEWIRE_PID $WIREPLUMBER_PID $PULSE_PID; do
    [ -n "$pid" ] || continue
    kill "$pid" 2>/dev/null || :
  done
}
trap 'exit 130' INT
trap 'exit 143' TERM HUP

if [ "$CONTINUE" != 1 ]; then
# Graphical privilege prompts need a Polkit agent. Do not start a second one
# when a desktop session already owns the role.
if ! pgrep -u "$(id -u)" -f 'polkit.*authentication-agent' >/dev/null 2>&1; then
  for agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/bin/lxpolkit; do
    [ -x "$agent" ] || continue
    "$agent" >/dev/null 2>&1 & POLKIT_PID=$!
    break
  done
  [ -n "$POLKIT_PID" ] || log 'no Polkit authentication agent found; graphical privilege prompts are unavailable'
fi

if [ "$START_PICOM" = 1 ] && command -v picom >/dev/null 2>&1 &&
   ! pgrep -u "$(id -u)" -x picom >/dev/null 2>&1; then
  picom >/dev/null 2>&1 & PICOM_PID=$!
fi
fi # end of first-start-only Polkit and compositor
start_dunst() {
  if [ "$START_DUNST" = 1 ] && command -v dunst >/dev/null 2>&1 &&
     ! pgrep -u "$(id -u)" -x dunst >/dev/null 2>&1; then
    dunst >/dev/null 2>&1 & DUNST_PID=$!
  fi
}
# Start the native notification daemon and wait until it owns the bus name.
#
# Without this wait the session's first notification can be sent before the
# daemon has registered, and `notify-send` then fails against a session bus that
# has no notification service. It is also what lets the welcome message below
# succeed on a machine where nothing else was running.
start_nirunotify() {
  command -v nirunotify >/dev/null 2>&1 || return 1
  nirunotify >/dev/null 2>&1 & NOTIFY_PID=$!
  # Notifications are optional. Do not add a five-second gate before the WM on
  # hosts without busctl or with a slow session bus.
  command -v busctl >/dev/null 2>&1 || return 0
  i=0
  while [ "$i" -lt 15 ]; do
    if busctl --user --no-pager status org.freedesktop.Notifications >/dev/null 2>&1; then
      return 0
    fi
    kill -0 "$NOTIFY_PID" 2>/dev/null || return 0
    sleep 0.05
    i=$((i + 1))
  done
  return 0
}
# One value of a [section] in config.toml (no quotes), or nothing.
config_value() {
  awk -F= -v section="$1" -v key="$2" '
    /^[[:space:]]*\[/ { line = $0; gsub(/[][[:space:]]/, "", line); inside = (line == section); next }
    inside {
      k = $1; gsub(/[[:space:]]/, "", k)
      if (k == key) { v = $2; sub(/#.*/, "", v); gsub(/[ \t"]/, "", v); print v; exit }
    }
  ' "$CONFIG_HOME/niruwm/config.toml" 2>/dev/null || :
}
# Fixed or solar night light (the default) has a watcher; manual has none.
nightlight_wanted() {
  [ "$(config_value nightlight mode)" != manual ] &&
    command -v niructl >/dev/null 2>&1 && command -v gammastep >/dev/null 2>&1
}
# A battery of the computer itself, not of a wireless mouse (scope Device).
has_system_battery() {
  for hb_dir in /sys/class/power_supply/*; do
    [ "$(cat "$hb_dir/type" 2>/dev/null)" = Battery ] || continue
    [ "$(cat "$hb_dir/scope" 2>/dev/null)" = Device ] && continue
    return 0
  done
  return 1
}
power_auto_wanted() {
  [ "$(config_value battery auto_profile)" != false ] &&
    command -v niructl >/dev/null 2>&1 && command -v powerprofilesctl >/dev/null 2>&1 &&
    has_system_battery
}
if [ "$CONTINUE" != 1 ]; then
# Clipboard history is a small foreground daemon that owns no policy beyond
# the bounded local file in ~/.local/state/niru. It is optional and silent.
if command -v niruclipboard >/dev/null 2>&1; then
  niruclipboard daemon >>"$WM_LOG" 2>&1 & CLIPBOARD_PID=$!
fi

# Gestures are opt-in at the OS level: libinput must be installed and the user
# must be allowed to read input devices. The bridge exits harmlessly otherwise.
if [ "${START_GESTURES:-1}" = 1 ] && command -v nirugestured >/dev/null 2>&1 &&
   command -v libinput >/dev/null 2>&1; then
  nirugestured daemon >>"$WM_LOG" 2>&1 & GESTURES_PID=$!
fi

case "$NOTIFICATION_PROVIDER" in
  auto)
    if command -v nirunotify >/dev/null 2>&1; then
      start_nirunotify || :
    else
      start_dunst
    fi
    ;;
  native)
    if command -v nirunotify >/dev/null 2>&1; then
      start_nirunotify || :
    else
      log "notification provider native requested, but nirunotify is not installed"
    fi
    ;;
  dunst)
    start_dunst
    ;;
  external)
    log "notification provider external: no daemon started"
    ;;
  *)
    log "unknown NOTIFICATION_PROVIDER=$NOTIFICATION_PROVIDER; expected auto, native, dunst or external"
    ;;
esac

# ── Night-light schedule ────────────────────────────────────────────────────
# Manual mode does nothing here. Fixed/solar mode (the default) starts one watcher that owns
# every gammastep call and re-applies after resume or output changes.
# 0.25.2: a file without a mode gets the default, which follows the sun.
if nightlight_wanted; then
  niructl nightlight watch >/dev/null 2>&1 & NIGHTLIGHT_PID=$!
fi

# ── Power profile follows the power source ──────────────────────────────────
# [battery] auto_profile (on by default): power-saver on battery, balanced on
# AC. Only on a machine with a system battery and power-profiles-daemon.
if power_auto_wanted; then
  niructl powerprofile watch >>"$WM_LOG" 2>&1 & POWER_PID=$!
fi

# ── Battery charge limit ───────────────────────────────────────────────────
# [battery] charge_limit (80 % by default) on laptops whose firmware supports
# it; "charge to full once" ends here, at the next login.
if command -v niructl >/dev/null 2>&1 && ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1; then
  niructl battery apply >/dev/null 2>&1 || log "battery charge limit not applied: $(niructl battery apply 2>&1 | tail -1)"
fi

# ── Idle ladder ─────────────────────────────────────────────────────────────
# NIRUIDLE is part of NIRUWM and owns the whole sequence: screensaver after
# idle_minutes, lock lock_after_minutes later, display off dpms_off_minutes
# after that. It reads ~/.config/niruui/screensaver.toml, the same file
# NIRUSCREENSAVER uses, so there is one place to change the times.
#
# xidlehook is not required and, when both were running, two ladders competed:
# the second one locked the screen again the moment the first one unlocked it.
NIRUIDLE_BIN=""
for candidate in "$SELF_DIR/niruidle" "$HOME/.local/bin/niruidle"; do
  [ -x "$candidate" ] && { NIRUIDLE_BIN="$candidate"; break; }
done
# A killed session (rather than a normal logout) can leave its idle daemon
# reparented to init. Two ladders then compete: the stale one sees the same X
# idle time and can lock the screen again right after an unlock. Stop only the
# one for this display; another X session keeps its own.
for pid in $(pgrep -u "$(id -u)" -x niruidle 2>/dev/null); do
  [ -n "$pid" ] || continue
  old_display=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p')
  [ "$old_display" = "$DISPLAY" ] || continue
  log "stopping stale niruidle $pid from an earlier session"
  kill "$pid" 2>/dev/null || :
done
if [ "$START_IDLE" = 1 ] && [ -n "$NIRUIDLE_BIN" ]; then
  "$NIRUIDLE_BIN" >/dev/null 2>&1 & IDLE_PID=$!
elif [ "$START_IDLE" = 1 ]; then
  # Fallback for an install without niruidle: lock on a plain timeout so the
  # screen is never left unlocked forever.
  if command -v xss-lock >/dev/null 2>&1; then
    LOCKER=slock
    xss-lock --transfer-sleep-lock -- "$LOCKER" >/dev/null 2>&1 & LOCK_PID=$!
  fi
fi

# ── Lock before suspend ─────────────────────────────────────────────────────
# Hold a logind/elogind delay inhibitor for sleep. When PrepareForSleep(true)
# arrives, lock and wait for NIRULOCK's verified readiness, then release the
# inhibitor. A delay inhibitor is finite: logind/elogind may proceed after its
# InhibitDelayMaxSec even if the inner command is still running, so this cannot
# honestly promise to veto an external suspend forever. Report a lock failure
# loudly instead of claiming a guarantee the platform does not provide.
sleep_lock_loop() {
  INHIBIT_PID=""
  trap 'if [ -n "$INHIBIT_PID" ]; then kill "$INHIBIT_PID" 2>/dev/null || :; fi; exit 0' TERM INT HUP
  while :; do
    "$NIRU_INHIBIT" --what=sleep --mode=delay --who=NIRU --why="Lock before suspend" \
      sh -c 'if dbus-monitor --system "type=signal,interface=org.freedesktop.login1.Manager,member=PrepareForSleep" 2>/dev/null | grep -m1 "boolean true" >/dev/null; then
               niructl lock --reason suspend || {
                 echo "niruwm-session: lock failed; external suspend delay is finite and the system may sleep unlocked" >&2
                 command -v notify-send >/dev/null 2>&1 && notify-send -a NIRUX -u critical "Lock before suspend failed" "The display locker did not become ready. The system may suspend unlocked." >/dev/null 2>&1 || :
               }
             fi' &
    INHIBIT_PID=$!
    wait "$INHIBIT_PID" 2>/dev/null || :
    INHIBIT_PID=""
    sleep 1
  done
}
NIRU_INHIBIT=""
for candidate in systemd-inhibit elogind-inhibit; do
  if command -v "$candidate" >/dev/null 2>&1; then NIRU_INHIBIT="$candidate"; break; fi
done
if [ "$START_SLEEP_LOCK" = 1 ] && [ -n "$NIRU_INHIBIT" ] \
   && command -v dbus-monitor >/dev/null 2>&1 \
   && command -v niructl >/dev/null 2>&1 \
   && command -v nirulock >/dev/null 2>&1; then
  sleep_lock_loop & SLEEP_LOCK_PID=$!
else
  log "lock-before-suspend provider unavailable (needs loginctl inhibit, dbus-monitor, niructl and nirulock)"
fi

# Apply the opt-in display profile before the WM reads monitor geometry.
# A missing profile or output must leave the connected screens usable; the
# command restores the previous layout on a failed apply and logs the reason.
if command -v niructl >/dev/null 2>&1; then
  niructl display startup apply >>"$WM_LOG" 2>&1 || log 'startup display profile was not applied'
else
  log 'startup display profile skipped: niructl is not installed'
fi

# Watch for dock and hotplug layout changes for the rest of the session. The
# watcher owns a per-DISPLAY PID file, so a second one exits immediately
# instead of competing; start it in the background so the WM is never delayed.
if command -v niructl >/dev/null 2>&1; then
  niructl display watch --quiet >>"$WM_LOG" 2>&1 & DISPLAY_WATCH_PID=$!
else
  log 'display watch unavailable: niructl is not installed'
fi

# The WM owns every bar, including restart and logout cleanup.

# The shell waits for the WM and cleans up session helpers. The WM cleans up
# its own bars before returning.
# The manager's own words go to the session log even when the display
# manager throws stderr away. A session that stops without a reason is what a
# blank screen with only the pointer looks like; this is the one place a
# person can find out why afterwards.
if [ "$CONTINUE" != 1 ]; then
{
  printf '\n=== %s session start ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  printf 'exec: %s\n' "$WM"
  printf 'config: %s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/niruwm/config.toml"
} >>"$WM_LOG" 2>/dev/null || WM_LOG=/dev/null
fi
if [ "$CONTINUE" != 1 ] && command -v niructl >/dev/null 2>&1; then
  (
    i=0
    while [ "$i" -lt 100 ]; do
      pgrep -u "$(id -u)" -x niruwm >/dev/null 2>&1 && break
      sleep 0.2
      i=$((i + 1))
    done
    sleep 0.5
    niructl autostart
    welcome=1
    case "$WELCOME_NOTIFICATION" in
      always) ;;
      once) [ ! -e "$LOG_DIR/welcome-shown" ] || welcome=0 ;;
      off) welcome=0 ;;
      *) log "unknown WELCOME_NOTIFICATION=$WELCOME_NOTIFICATION; expected always, once or off" ;;
    esac
    if [ "$welcome" = 1 ] && command -v notify-send >/dev/null 2>&1; then
      notify-send -a NIRUX -t 6000 "Welcome to NIRUX" "A minimal X11 desktop" >/dev/null 2>&1 || :
      [ "$WELCOME_NOTIFICATION" != once ] || : > "$LOG_DIR/welcome-shown"
    fi
  ) >>"$WM_LOG" 2>&1 & AUTOSTART_PID=$!
fi
if [ "$CONTINUE" != 1 ] && command -v nirux >/dev/null 2>&1; then
  nirux sounds play startup >/dev/null 2>&1 & STARTUP_SOUND_PID=$!
fi
# Start NIRUSHARE only when its component is installed and no service is
# already running. It is session-scoped and cleaned up with the other helpers.
if command -v nirushare >/dev/null 2>&1 &&
   ! pgrep -u "$(id -u)" -x nirushare >/dev/null 2>&1; then
  mkdir -p "$LOG_DIR" 2>/dev/null || :
  nirushare serve >>"$LOG_DIR/nirushare.log" 2>&1 & NIRUSHARE_PID=$!
fi
# NIRUDICTATE (a NIRUX extra) listens for its dictation shortcut itself. Start
# it only when it is installed; `nirudictate autostart` honours its own
# autostart setting and exits at once when an instance already runs. It is
# session-scoped like the helpers above and stopped at logout.
if command -v nirudictate >/dev/null 2>&1; then
  mkdir -p "$LOG_DIR" 2>/dev/null || :
  nirudictate autostart >>"$LOG_DIR/nirudictate.log" 2>&1 & NIRUDICTATE_PID=$!
fi
fi # end of first-start-only helpers

# ── Helpers across a restart in place ───────────────────────────────────────
# Every PID this script tracks, so logout still stops what an earlier copy of
# the script started.
TRACKED="STATUS_PID DUNST_PID NOTIFY_PID CLIPBOARD_PID GESTURES_PID STARTUP_SOUND_PID PICOM_PID IDLE_PID LOCK_PID BAT_PID AUTO_PID SLEEP_LOCK_PID NIGHTLIGHT_PID POLKIT_PID AUTOSTART_PID DISPLAY_WATCH_PID NIRUSHARE_PID NIRUDICTATE_PID POWER_PID PIPEWIRE_PID WIREPLUMBER_PID PULSE_PID"
# The helpers that come from the NIRUX generation and are replaced when their
# program changed: PID variable and program name. nirulock is never in this
# list: a lock screen is not touched by a restart.
REPLACEABLE="NOTIFY_PID:nirunotify CLIPBOARD_PID:niruclipboard GESTURES_PID:nirugestured IDLE_PID:niruidle NIGHTLIGHT_PID:niructl DISPLAY_WATCH_PID:niructl POWER_PID:niructl NIRUSHARE_PID:nirushare"
# A checksum of the program a helper was started from, so a changed program
# is found even when it was replaced at the same path.
program_sum() {
  ps_file=$(command -v "$1" 2>/dev/null) || return 0
  ps_file=$(readlink -f "$ps_file" 2>/dev/null || printf '%s' "$ps_file")
  [ -r "$ps_file" ] || return 0
  cksum < "$ps_file" 2>/dev/null | awk '{print $1 "-" $2}'
}
record_sums() {
  for entry in $REPLACEABLE; do
    var=${entry%%:*}
    eval "pid=\${$var:-}"
    [ -n "$pid" ] || continue
    eval "SUM_$var=\$(program_sum ${entry#*:})"
  done
}
# Hand every tracked PID and program checksum to the next copy of this script.
export_tracked() {
  for var in $TRACKED; do
    eval "pid=\${$var:-}"
    eval "sum=\${SUM_$var:-}"
    eval "NIRUWM_TRACK_$var=\"\$pid \$sum\""
    export "NIRUWM_TRACK_$var"
  done
}
import_tracked() {
  value=""
  for var in $TRACKED; do
    eval "value=\${NIRUWM_TRACK_$var:-}"
    unset "NIRUWM_TRACK_$var"
    pid=${value%% *}
    sum=${value#* }
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    eval "$var=\$pid"
    case "$sum" in ''|*[!0-9-]*) ;; *) eval "SUM_$var=\$sum" ;; esac
  done
}
alive() {
  [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1
  # A helper that exited stays a zombie until the shell reaps it.
  al_state=$(sed -n 's/^State:[[:space:]]*\([A-Z]\).*/\1/p' "/proc/$1/status" 2>/dev/null)
  [ "$al_state" != Z ]
}
stop_helper() {
  kill "$1" 2>/dev/null || return 0
  sh_i=0
  while [ "$sh_i" -lt 30 ] && alive "$1"; do sleep 0.1; sh_i=$((sh_i + 1)); done
  if alive "$1"; then kill -9 "$1" 2>/dev/null || :; fi
}
# The PIDs of program $1 that belong to this display. Another X session of
# the same user (a second seat, a nested test) keeps its own processes.
display_pids() {
  for dp_pid in $(pgrep -u "$(id -u)" -x "$1" 2>/dev/null); do
    dp_display=$(tr '\0' '\n' < "/proc/$dp_pid/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p')
    [ "$dp_display" = "$DISPLAY" ] && printf '%s\n' "$dp_pid"
  done
  return 0
}
on_this_display() { [ -n "$(display_pids "$1")" ]; }
# The PIDs of this display's `niructl ARGS...` (several watchers share the
# program, so the arguments tell them apart).
display_niructl_pids() {
  for dn_pid in $(display_pids niructl); do
    dn_args=$(tr '\0' ' ' < "/proc/$dn_pid/cmdline" 2>/dev/null | cut -d' ' -f2-)
    case "$dn_args" in "$1"*) printf '%s\n' "$dn_pid" ;; esac
  done
  return 0
}
# A helper that should run but does not (its setting changed since the login,
# or it stopped) is started after a restart in place. One that runs without
# being tracked, started by hand or by an older script, is left alone.
ensure_helper() {
  eh_var=$1; eh_args=$2; eh_pid=""
  eval "eh_pid=\${$eh_var:-}"
  alive "$eh_pid" && return 0
  [ -z "$(display_niructl_pids "$eh_args")" ] || return 0
  eval "$eh_var="
  start_helper "$eh_var"
  eval "SUM_$eh_var=\$(program_sum niructl)"
  log "restart: started the missing helper: niructl $eh_args"
}
ensure_helpers() {
  if nightlight_wanted; then ensure_helper NIGHTLIGHT_PID "nightlight watch"; fi
  if power_auto_wanted; then ensure_helper POWER_PID "powerprofile watch"; fi
  return 0
}
# Bars left by a manager that stopped without stopping them (a crash).
stop_display_bars() {
  for sb_pid in $(display_pids nirubar); do kill "$sb_pid" 2>/dev/null || :; done
}
start_helper() {
  case "$1" in
    NOTIFY_PID) start_nirunotify || : ;;
    CLIPBOARD_PID) niruclipboard daemon >>"$WM_LOG" 2>&1 & CLIPBOARD_PID=$! ;;
    GESTURES_PID) nirugestured daemon >>"$WM_LOG" 2>&1 & GESTURES_PID=$! ;;
    IDLE_PID) niruidle >/dev/null 2>&1 & IDLE_PID=$! ;;
    NIGHTLIGHT_PID) niructl nightlight watch >/dev/null 2>&1 & NIGHTLIGHT_PID=$! ;;
    DISPLAY_WATCH_PID) niructl display watch --quiet >>"$WM_LOG" 2>&1 & DISPLAY_WATCH_PID=$! ;;
    NIRUSHARE_PID) nirushare serve >>"$LOG_DIR/nirushare.log" 2>&1 & NIRUSHARE_PID=$! ;;
    POWER_PID) niructl powerprofile watch >>"$WM_LOG" 2>&1 & POWER_PID=$! ;;
  esac
}
# Replace each running helper whose program is no longer the installed one.
refresh_helpers() {
  rh_replaced=""
  rh_old=""
  rh_pid=""
  for rh_entry in $REPLACEABLE; do
    rh_var=${rh_entry%%:*}
    rh_name=${rh_entry#*:}
    eval "rh_pid=\${$rh_var:-}"
    alive "$rh_pid" || continue
    eval "rh_old=\${SUM_$rh_var:-}"
    rh_new=$(program_sum "$rh_name")
    [ -n "$rh_new" ] || continue
    [ "$rh_old" != "$rh_new" ] || continue
    if [ "$rh_var" = IDLE_PID ] && { on_this_display nirulock || on_this_display niruscreensaver; }; then
      log "restart: niruidle keeps running while the screen is locked or the screensaver is up"
      continue
    fi
    stop_helper "$rh_pid"
    eval "$rh_var="
    start_helper "$rh_var"
    eval "SUM_$rh_var=\$rh_new"
    rh_replaced="$rh_replaced $rh_name"
  done
  if [ -n "$rh_replaced" ]; then
    log "restart: replaced helpers:$rh_replaced"
  else
    log "restart: no helper program changed"
  fi
}
# Status 75 from NIRUWM: run the installed session script, which may be newer
# than this one, in this same process. When it cannot be run, stay in this
# script and restart the window manager here.
restart_in_place() {
  log "restart in place requested: starting the installed NIRUWM; open windows are kept"
  NIRUWM_RESTARTED=1
  export NIRUWM_RESTARTED
  NIRUWM_PREVIOUS_WM="$WM_RUNNING"
  export NIRUWM_PREVIOUS_WM
  if [ -x "$SESSION_SCRIPT" ] && sh -n "$SESSION_SCRIPT" 2>/dev/null; then
    export_tracked
    NIRUWM_SESSION_CONTINUE=1
    export NIRUWM_SESSION_CONTINUE
    exec "$SESSION_SCRIPT" "$@"
  fi
  log "restart: $SESSION_SCRIPT cannot be run; keeping this session script"
  refresh_helpers
  ensure_helpers
}
if [ "$CONTINUE" = 1 ]; then
  import_tracked
  printf '\n=== %s restart in place ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" >>"$WM_LOG" 2>/dev/null || :
  refresh_helpers
  ensure_helpers
else
  record_sums
fi
# A crash of the window manager must not end the session. The X server and
# every program keep running; a new NIRUWM adopts the open windows (they keep
# their workspaces and scratchpad slots) and skips the session restore, since
# those programs are still running. Only a deliberate quit (status 0, from
# Super+Ctrl+Shift+Q or `niructl quit`) or a signal to this script ends the
# session; so do HUP, INT and TERM. A manager that keeps failing is given up on after
# WM_RESTART_LIMIT crashes within WM_RESTART_WINDOW seconds, so a broken
# installation still ends at the login screen instead of looping forever.
WM_RESTART_LIMIT=${WM_RESTART_LIMIT:-3}
WM_RESTART_WINDOW=${WM_RESTART_WINDOW:-60}
crashes=""
STATUS=0
# After a restart in place, the manager that ran before. If the new one fails
# straight away, the session goes back to it instead of ending.
FALLBACK_WM="${NIRUWM_PREVIOUS_WM:-}"
unset NIRUWM_PREVIOUS_WM
WM_RUNNING=""
while :; do
  STATUS=0
  WM_RUNNING=$(readlink -f "$WM" 2>/dev/null || printf '%s' "$WM")
  started=$(date +%s)
  "$WM" "$@" || STATUS=$?
  # Status 0 is a deliberate quit. HUP, INT and TERM (129, 130, 143) are a
  # logout or someone stopping the manager on purpose. 75 asks for a restart
  # in place. Anything else (a panic, an abort, SIGSEGV, SIGKILL from the
  # OOM killer) is a crash.
  case "$STATUS" in
    0|129|130|143) break ;;
    "$WM_RESTART_STATUS")
      restart_in_place "$@"
      FALLBACK_WM="$WM_RUNNING"
      continue
      ;;
  esac
  now=$(date +%s)
  if [ -n "$FALLBACK_WM" ] && [ -x "$FALLBACK_WM" ] && [ "$FALLBACK_WM" != "$WM_RUNNING" ] &&
     [ $((now - started)) -lt 20 ] &&
     { ! command -v xprop >/dev/null 2>&1 || xprop -root -len 1 _NET_NUMBER_OF_DESKTOPS >/dev/null 2>&1; }; then
    log "the restarted NIRUWM ($WM_RUNNING) stopped with status $STATUS within $((now - started))s; running the previous one again ($FALLBACK_WM)"
    WM="$FALLBACK_WM"
    FALLBACK_WM=""
    stop_display_bars
    NIRUWM_RESTARTED=1
    export NIRUWM_RESTARTED
    continue
  fi
  FALLBACK_WM=
  recent=""
  for at in $crashes; do
    [ $((now - at)) -lt "$WM_RESTART_WINDOW" ] && recent="$recent $at"
  done
  crashes="$recent $now"
  count=$(printf '%s\n' $crashes | grep -c .)
  if [ "$count" -gt "$WM_RESTART_LIMIT" ]; then
    log "niruwm stopped with status $STATUS $count times within ${WM_RESTART_WINDOW}s; ending the session"
    break
  fi
  # No display left (the X server itself went away): nothing to restart.
  if command -v xprop >/dev/null 2>&1 && ! xprop -root -len 1 _NET_NUMBER_OF_DESKTOPS >/dev/null 2>&1; then
    log "niruwm stopped with status $STATUS and the display is gone; ending the session"
    break
  fi
  log "niruwm stopped with status $STATUS (crash $count of at most $WM_RESTART_LIMIT within ${WM_RESTART_WINDOW}s); starting it again, open windows are kept"
  # The bars belonged to the manager that died; the new one starts its own.
  # Only this display's: another session of the same user keeps its bars.
  stop_display_bars
  sleep 1
  NIRUWM_RESTARTED=1
  export NIRUWM_RESTARTED
done
# The WM has stopped its bars; the EXIT trap cleans up session helpers.
exit "$STATUS"
